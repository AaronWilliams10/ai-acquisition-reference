# None of these are needed for `npm run demo`. They show where real
# credentials would go once mock adapters are swapped for real ones.

# Apify: discovery and enrichment
APIFY_TOKEN=
APIFY_X_SEARCH_ACTOR=        # an X/Twitter search actor ID, e.g. username~actor-name
APIFY_WEBSITE_ACTOR=         # a website crawler actor ID

# X API v2: profiles, DMs, replies (sending stays behind the approval gate)
X_API_BEARER_TOKEN=

# LLM for company extraction, soft signals and drafting
LLM_API_KEY=

# Approval + orchestration
N8N_INBOUND_WEBHOOK_URL=
APPROVAL_CHANNEL=            # e.g. a Slack or Telegram channel ID
